configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "wezterm";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " 󰀻 App ";
    display-run: " 󰆍 Run ";
    display-window: " 󰖯 Win ";
    sidebar-mode: true;
    font: "JetBrainsMono Nerd Font 9.5";
}

@theme "/dev/null"

* {
    bg-col:  #181825ee;
    bg-col-light: #313244cc;
    border-col: #cba6f7;
    selected-col: #313244cc;
    mauve: #cba6f7;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #7f849c;

    width: 440;
    background-color: transparent;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 310px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 10px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    background-color: @mauve;
    padding: 5px 10px;
    text-color: #11111b;
    border-radius: 6px;
    margin: 8px 0px 0px 10px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 5px 8px;
    margin: 8px 10px 0px 6px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 6px;
    placeholder: "󰍉 Cari aplikasi...";
    placeholder-color: @grey;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 4px 10px 6px 10px;
    columns: 2;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 5px 8px;
    margin: 2px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 18px;
    margin: 0px 8px 0px 0px;
}

element selected {
    background-color:  @selected-col;
    text-color: @mauve;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 6px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @mauve;
}
