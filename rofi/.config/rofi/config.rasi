configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "alacritty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " 󰀻 Aplikasi ";
    display-run: " 󰆍 Jalankan ";
    display-window: " 󰖯 Jendela ";
    sidebar-mode: true;
    font: "JetBrainsMono Nerd Font 11";
}

@theme "/dev/null"

* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #cba6f7;
    selected-col: #313244;
    mauve: #cba6f7;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;

    width: 560;
    background-color: @bg-col;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 380px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 8px;
    padding: 4px;
}

prompt {
    background-color: @mauve;
    padding: 6px 10px;
    text-color: #11111b;
    border-radius: 6px;
    margin: 12px 0px 0px 12px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 12px 12px 0px 8px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 6px;
    placeholder: "Ketik nama aplikasi...";
    placeholder-color: @grey;
}

listview {
    border: 0px 0px 0px;
    padding: 8px 0px 0px;
    margin: 8px 12px 8px 12px;
    columns: 1;
    lines: 7;
    background-color: @bg-col;
}

element {
    padding: 8px 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color:  @selected-col;
    text-color: @mauve;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @mauve;
}
