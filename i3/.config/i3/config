# =============================================================================
# i3 Configuration — Catppuccin Mocha (Synced with Torrayz/dotfilesku)
# =============================================================================

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Primary Terminal: WezTerm (GUI Tabs [+] & [x], Custom PNG Logo support)
set $term wezterm start
set $term_alt kitty
set $menu rofi -show drun -show-icons
set $keybinds ~/.config/rofi/keybindings.sh
set $filemanager thunar
set $editor code

font pango:JetBrainsMono Nerd Font 8.5

# Catppuccin Mocha Colors
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

client.focused           $mauve    $base $text  $rosewater $mauve
client.focused_inactive  $surface1 $base $text  $rosewater $surface1
client.unfocused         $surface0 $base $text  $rosewater $surface0
client.urgent            $peach    $base $peach $overlay0  $peach
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base

# Borders & Gaps
default_border pixel 1
default_floating_border pixel 1
gaps inner 4
gaps outer 1
smart_borders on

# Autostart Services
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 1e1e2e --nofork
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec_always --no-startup-id feh --bg-fill ~/.config/sway/wallpaper.png
exec_always --no-startup-id ~/.config/polybar/launch.sh

# -----------------------------------------------------------------------------
# Keybindings — Synced with Torrayz/dotfilesku
# -----------------------------------------------------------------------------

# Terminal (Super + T & Super + Enter)
bindsym $mod+t exec --no-startup-id $term
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+Return exec --no-startup-id $term_alt

# Spotlight App Search (Super + Space, Super + D, Super + Ctrl + Enter)
bindsym $mod+space exec --no-startup-id $menu
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+Ctrl+Return exec --no-startup-id $menu

# Search Keybindings Cheat-Sheet (Super + /, Super + ?, Super + Ctrl + K)
bindsym $mod+slash exec --no-startup-id $keybinds
bindsym $mod+Shift+slash exec --no-startup-id $keybinds
bindsym $mod+Ctrl+k exec --no-startup-id $keybinds

# Core Apps
bindsym $mod+c exec --no-startup-id $editor
bindsym $mod+e exec --no-startup-id $filemanager
bindsym $mod+b exec --no-startup-id firefox
bindsym $mod+m exec --no-startup-id wezterm start -- btop
bindsym Ctrl+Mod1+Delete exec --no-startup-id wezterm start -- btop

# Kill Active Window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Quick Translate Selection (Super+G -> ID, Super+Shift+G -> EN)
bindsym $mod+g exec --no-startup-id sh -c 'notify-send -u critical "Terjemahan Indo:" "$(trans -b -t id "$(xclip -o -selection primary)")"'
bindsym $mod+Shift+g exec --no-startup-id sh -c 'notify-send -u critical "To English:" "$(trans -b -t en "$(xclip -o -selection primary)")"'

# Screenshots (F10, Print, Super+Shift+S, Super+Alt+S)
bindsym F10 exec --no-startup-id flameshot gui
bindsym $mod+F10 exec --no-startup-id flameshot gui
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym $mod+Mod1+s exec --no-startup-id flameshot gui
bindsym Print exec --no-startup-id flameshot gui

# Lock & Power Menu
bindsym $mod+Escape exec --no-startup-id i3lock -c 1e1e2e
bindsym $mod+Mod1+l exec --no-startup-id i3lock -c 1e1e2e
bindsym $mod+Ctrl+l exec --no-startup-id i3lock -c 1e1e2e
bindsym $mod+Shift+e exec --no-startup-id ~/.config/rofi/powermenu.sh
bindsym $mod+Ctrl+q exec --no-startup-id ~/.config/rofi/powermenu.sh

# Reload / Restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Ctrl+r restart

# Hardware Function Keys
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute exec --no-startup-id pamixer -t
bindsym XF86AudioMicMute exec --no-startup-id pamixer --default-source -t
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Window Navigation, Resize & Layout
floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Direct Resize with Super + Ctrl + Arrow
bindsym $mod+Ctrl+Right resize grow width 40 px or 5 ppt
bindsym $mod+Ctrl+Left resize shrink width 40 px or 5 ppt
bindsym $mod+Ctrl+Up resize shrink height 40 px or 5 ppt
bindsym $mod+Ctrl+Down resize grow height 40 px or 5 ppt

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+t floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Mod1+space focus mode_toggle
bindsym $mod+w layout toggle tabbed split
bindsym $mod+r layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+semicolon split h
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Nwg-look"] floating enable
