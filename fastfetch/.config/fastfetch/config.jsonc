// Compact Catnap Layout + Small Custom Logo (Calibrated for 1366x768)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/torray/logo.png",
        "width": 16,
        "height": 8,
        "padding": {
            "top": 0,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭──────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#35} user   {#keys}│",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": "│ {#36}{icon} distro {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#31} kernel {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#34} wm     {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#33}󰏖 pkgs   {#keys}│",
            "type": "packages"
        },
        {
            "key": "│ {#32}󰍛 cpu    {#keys}│",
            "type": "cpu"
        },
        {
            "key": "│ {#35} memory {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#32} batt   {#keys}│",
            "type": "battery"
        },
        {
            "key": "├──────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰──────────╯",
            "type": "custom"
        }
    ]
}
