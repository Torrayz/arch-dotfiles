// Compact system summary. Built-in art also works in Alacritty.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "arch",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "35",
            "title": "35"
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "[",
                "right": "]"
            },
            "width": 10
        },
        "percent": {
            "type": 3,
            "green": 50,
            "yellow": 80
        }
    },
    "modules": [
        {
            "type": "custom",
            "key": "{#35}╭─ 󰣇 TORRAY / ARCH ────────╮"
        },
        {
            "type": "title",
            "key": "{#35}│ {#95} User     {#35}│",
            "format": "{#95}{user-name}{#37}@{#96}{host-name}"
        },
        {
            "type": "os",
            "key": "{#35}│ {#96}󰣇 Distro   {#35}│",
            "format": "{pretty-name} ({arch})"
        },
        {
            "type": "kernel",
            "key": "{#35}│ {#91} Kernel   {#35}│",
            "format": "{sysname} {release}"
        },
        {
            "type": "uptime",
            "key": "{#35}│ {#93}󰅐 Uptime   {#35}│"
        },
        {
            "type": "packages",
            "key": "{#35}│ {#92}󰏖 Packages {#35}│"
        },
        {
            "type": "wm",
            "key": "{#35}│ {#94}󰖲 Desktop  {#35}│",
            "format": "{pretty-name} ({protocol-name})"
        },
        {
            "type": "terminal",
            "key": "{#35}│ {#95}󰆍 Terminal {#35}│"
        },
        {
            "type": "shell",
            "key": "{#35}│ {#92}󰞷 Shell    {#35}│"
        },
        {
            "type": "custom",
            "key": "{#34}├─ 󰻠 RESOURCES ────────────┤"
        },
        {
            "type": "cpu",
            "key": "{#34}│ {#96}󰍛 CPU      {#34}│"
        },
        {
            "type": "memory",
            "key": "{#34}│ {#95} Memory   {#34}│"
        },
        {
            "type": "disk",
            "key": "{#34}│ {#93}󰋊 Disk (/) {#34}│",
            "folders": "/"
        },
        {
            "type": "custom",
            "key": "{#34}╰──────────────────────────╯"
        }
    ]
}
