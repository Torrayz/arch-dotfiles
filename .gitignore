# Ignore VS Code runtime cache & storage inside stowed directories
vscode/.config/Code - OSS/*
!vscode/.config/Code - OSS/User/
vscode/.config/Code - OSS/User/*
!vscode/.config/Code - OSS/User/settings.json
!vscode/.config/Code - OSS/User/keybindings.json

vscode/.config/Code/*
!vscode/.config/Code/User/
vscode/.config/Code/User/*
!vscode/.config/Code/User/settings.json
!vscode/.config/Code/User/keybindings.json

# OS / Editor temporary files
*.swp
*.bak
.DS_Store
__pycache__/
*.pyc
