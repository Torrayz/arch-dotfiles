# =============================================================================
# Sway Configuration — Catppuccin Mocha (Synced with Torrayz/dotfilesku)
# =============================================================================

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Primary Terminal: WezTerm (GUI Tabs [+] & [x], Custom PNG Logo support)
set $term wezterm start
set $term_alt kitty
set $menu rofi -show drun -show-icons
set $keybinds ~/.config/rofi/keybindings.sh
set $filemanager thunar
set $editor code

font pango:JetBrainsMono Nerd Font 8.5

# -----------------------------------------------------------------------------
# Catppuccin Mocha Colors
# -----------------------------------------------------------------------------
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

client.focused           $mauve    $base $text  $rosewater $mauve
client.focused_inactive  $surface1 $base $text  $rosewater $surface1
client.unfocused         $surface0 $base $text  $rosewater $surface0
client.urgent            $peach    $base $peach $overlay0  $peach
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base

# -----------------------------------------------------------------------------
# Appearance, Gaps & Custom Wallpaper
# -----------------------------------------------------------------------------
default_border pixel 1
default_floating_border pixel 1
gaps inner 4
gaps outer 1
smart_borders on

output * bg ~/.config/sway/wallpaper.png fill

# -----------------------------------------------------------------------------
# Touchpad & Keyboard Configuration
# -----------------------------------------------------------------------------
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
    repeat_delay 250
    repeat_rate 35
}

# -----------------------------------------------------------------------------
# Autostart Services
# -----------------------------------------------------------------------------
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec mako
exec nm-applet --indicator
exec wl-paste --watch cliphist store
exec swayidle -w \
    timeout 600 'swaylock -f -c 1e1e2e' \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1e1e2e'

bar {
    swaybar_command waybar
}

# -----------------------------------------------------------------------------
# Keybindings — Synced with Torrayz/dotfilesku
# -----------------------------------------------------------------------------

# Terminal (Super + T & Super + Enter)
bindsym $mod+t exec $term
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term_alt

# Spotlight App Search (Super + Space, Super + D, Super + Ctrl + Enter)
bindsym $mod+space exec $menu
bindsym $mod+d exec $menu
bindsym $mod+Ctrl+Return exec $menu

# Search Keybindings Cheat-Sheet (Super + /, Super + ?, Super + Ctrl + K)
bindsym $mod+slash exec $keybinds
bindsym $mod+Shift+slash exec $keybinds
bindsym $mod+Ctrl+k exec $keybinds

# Core Apps & Custom Torray Hub Plugin
bindsym $mod+c exec $editor
bindsym $mod+e exec $filemanager
bindsym $mod+b exec firefox
bindsym $mod+m exec wezterm start -- btop
bindsym Ctrl+Mod1+Delete exec wezterm start -- btop
bindsym $mod+n exec ~/.config/polybar/scripts/torray-hub.py --dash
bindsym $mod+p exec ~/.config/polybar/scripts/torray-hub.py --music
bindsym $mod+Shift+w exec ~/.config/polybar/scripts/torray-hub.py --wall
for_window [title="Torray Hub"] floating enable, border pixel 2

# Kill Active Window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Clipboard History
bindsym $mod+v exec cliphist list | rofi -dmenu -p "󰅌 Clipboard" | cliphist decode | wl-copy

# Quick Translate Selection (from Torrayz/dotfilesku: Super+G -> ID, Super+Shift+G -> EN)
bindsym $mod+g exec sh -c 'notify-send -u critical "Terjemahan Indo:" "$(trans -b -t id "$(wl-paste -p)")"'
bindsym $mod+Shift+g exec sh -c 'notify-send -u critical "To English:" "$(trans -b -t en "$(wl-paste -p)")"'

# Screenshots (F10, Print, Super+Shift+S, Super+Alt+S)
bindsym F10 exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+F10 exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+Mod1+s exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "Area disalin ke clipboard"
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "Area disalin ke clipboard"
bindsym Mod1+F10 exec grim - | wl-copy && notify-send "Screenshot" "Layar penuh disalin ke clipboard"

# Lock Screen & Power Menu
bindsym $mod+Escape exec swaylock -f -c 1e1e2e
bindsym $mod+Mod1+l exec swaylock -f -c 1e1e2e
bindsym $mod+Ctrl+l exec swaylock -f -c 1e1e2e
bindsym $mod+Shift+e exec ~/.config/rofi/powermenu.sh
bindsym $mod+Ctrl+q exec ~/.config/rofi/powermenu.sh

# Reload Config
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload
bindsym $mod+Ctrl+r reload

# -----------------------------------------------------------------------------
# Hardware Function Keys
# -----------------------------------------------------------------------------
bindsym --locked XF86AudioRaiseVolume exec pamixer -i 5
bindsym --locked XF86AudioLowerVolume exec pamixer -d 5
bindsym --locked XF86AudioMute exec pamixer -t
bindsym --locked XF86AudioMicMute exec pamixer --default-source -t
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# -----------------------------------------------------------------------------
# Window Navigation, Resize & Layout (Synced with Torrayz/dotfilesku)
# -----------------------------------------------------------------------------
floating_modifier $mod normal

# Move Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move Window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Direct Resize with Super + Ctrl + Arrow (like Torrayz/dotfilesku!)
bindsym $mod+Ctrl+Right resize grow width 40px
bindsym $mod+Ctrl+Left resize shrink width 40px
bindsym $mod+Ctrl+Up resize shrink height 40px
bindsym $mod+Ctrl+Down resize grow height 40px

# Fullscreen, Float, Group/Tabbed, Split
bindsym $mod+f fullscreen
bindsym $mod+Shift+t floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Mod1+space focus mode_toggle
bindsym $mod+w layout toggle tabbed split
bindsym $mod+r layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+semicolon split h
bindsym $mod+a focus parent

# -----------------------------------------------------------------------------
# Workspaces (1 - 10)
# -----------------------------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Floating Rules
for_window [app_id="pavucontrol"] floating enable, resize set 760 500
for_window [app_id="blueman-manager"] floating enable, resize set 700 480
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="nwg-look"] floating enable
for_window [app_id="imv"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

include /etc/sway/config.d/*
