{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 5,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "custom/dash",
    "sway/workspaces",
    "custom/quickterm",
    "custom/quickcode",
    "custom/keybinds"
  ],
  "modules-center": [
    "custom/clock_toggle"
  ],
  "modules-right": [
    "custom/sysinfo",
    "backlight",
    "pulseaudio",
    "custom/net_toggle",
    "battery",
    "tray",
    "custom/power"
  ],

  "custom/dash": {
    "format": "󰣇",
    "tooltip-format": "Torray Dash Control Center (Klik Kanan: Cari Aplikasi)",
    "on-click": "~/.config/rofi/dashboard.sh",
    "on-click-right": "rofi -show drun -show-icons"
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "focused": "󰮯",
      "urgent": "",
      "default": "",
      "persistent": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "custom/quickterm": {
    "format": "󰆍",
    "tooltip-format": "Buka Terminal WezTerm (Super+T)",
    "on-click": "wezterm start"
  },

  "custom/quickcode": {
    "format": "󰨞",
    "tooltip-format": "Buka VS Code (Super+C)",
    "on-click": "code"
  },

  "custom/keybinds": {
    "format": "󰌌",
    "tooltip-format": "Cari Shortcut & Keybindings (Super+/)",
    "on-click": "~/.config/rofi/keybindings.sh"
  },

  "custom/clock_toggle": {
    "exec": "~/.config/polybar/scripts/clock.sh",
    "interval": 1,
    "signal": 9,
    "tooltip-format": "Klik Kiri: Toggle Tanggal Lengkap | Klik Kanan: Ganti Wallpaper",
    "on-click": "~/.config/polybar/scripts/clock.sh --toggle",
    "on-click-right": "~/.config/polybar/scripts/wallpaper-cycle.sh"
  },

  "custom/sysinfo": {
    "exec": "~/.config/polybar/scripts/sysinfo.sh",
    "interval": 2,
    "signal": 8,
    "tooltip-format": "Klik Kiri: Expand/Collapse Info RAM & Suhu | Klik Kanan: Buka btop",
    "on-click": "~/.config/polybar/scripts/sysinfo.sh --toggle",
    "on-click-right": "wezterm start -- btop"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "Kecerahan Layar: {percent}% (Klik untuk ubah, atau Scroll)",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "~/.config/polybar/scripts/hw-action.sh bright-cycle",
    "on-scroll-up": "~/.config/polybar/scripts/hw-action.sh bright-up",
    "on-scroll-down": "~/.config/polybar/scripts/hw-action.sh bright-down"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "~/.config/polybar/scripts/hw-action.sh vol-toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },

  "custom/net_toggle": {
    "exec": "~/.config/polybar/scripts/net.sh",
    "interval": 3,
    "signal": 10,
    "tooltip-format": "Klik Kiri: Tampilkan Nama Wi-Fi & IP | Klik Kanan: Pilih Wi-Fi",
    "on-click": "~/.config/polybar/scripts/net.sh --toggle",
    "on-click-right": "~/.config/rofi/wifi.sh"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC0",
    "interval": 15,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "~/.config/polybar/scripts/hw-action.sh bat-info"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 5
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power Menu (Super+Shift+E)",
    "on-click": "~/.config/rofi/powermenu.sh"
  }
}
