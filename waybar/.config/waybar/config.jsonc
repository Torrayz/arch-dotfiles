{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 4,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "custom/hub",
    "sway/workspaces",
    "custom/keybinds"
  ],
  "modules-center": [
    "custom/media",
    "custom/clock_toggle"
  ],
  "modules-right": [
    "custom/sysinfo",
    "custom/quickwall",
    "backlight",
    "pulseaudio",
    "custom/net_toggle",
    "custom/power_status",
    "tray",
    "custom/power"
  ],

  "custom/hub": {
    "format": "󰣇  Hub",
    "tooltip-format": "Klik Kiri: Buka Torray Hub (Kontrol, Musik, Wallpaper) | Klik Kanan: Cari Aplikasi",
    "on-click": "~/.config/polybar/scripts/torray-hub.py --dash",
    "on-click-right": "rofi -show drun -show-icons"
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}  {windows}",
    "format-window-separator": "  ",
    "window-rewrite-default": "󰣆",
    "window-rewrite": {
      "class<org.wezfurlong.wezterm>": "󰆍",
      "class<kitty>": "󰆍",
      "class<UXTerm>": "󰆍",
      "class<XTerm>": "󰆍",
      "class<code-oss>": "󰨞",
      "class<Code>": "󰨞",
      "class<firefox>": "󰈹",
      "class<Thunar>": "󰉋",
      "class<mpv>": "󰎆",
      "title<.*btop.*>": "󰻠",
      "title<.*nvim.*>": ""
    }
  },

  "custom/keybinds": {
    "format": "󰌌 ",
    "tooltip-format": "Cari Shortcut & Keybindings (Super+/)",
    "on-click": "~/.config/rofi/keybindings.sh"
  },

  "custom/quickwall": {
    "format": "󰸉 ",
    "tooltip-format": "Klik Kiri: Buka Studio Wallpaper | Klik Kanan: Ganti Wallpaper Cepat",
    "on-click": "~/.config/polybar/scripts/torray-hub.py --wall",
    "on-click-right": "~/.config/polybar/scripts/wallpaper-cycle.sh"
  },

  "custom/media": {
    "exec": "~/.config/polybar/scripts/media.sh",
    "interval": 1,
    "tooltip-format": "Klik Kiri: Play/Pause | Klik Kanan: Buka Music Visualizer | Scroll: Next/Prev",
    "on-click": "~/.config/polybar/scripts/media.sh --play-pause",
    "on-click-right": "~/.config/polybar/scripts/media.sh --hub",
    "on-scroll-up": "~/.config/polybar/scripts/media.sh --next",
    "on-scroll-down": "~/.config/polybar/scripts/media.sh --prev"
  },

  "custom/clock_toggle": {
    "exec": "~/.config/polybar/scripts/clock.sh",
    "interval": 1,
    "signal": 9,
    "tooltip-format": "Klik Kiri: Toggle Tanggal Lengkap | Klik Kanan: Studio Wallpaper",
    "on-click": "~/.config/polybar/scripts/clock.sh --toggle",
    "on-click-right": "~/.config/polybar/scripts/torray-hub.py --wall"
  },

  "custom/sysinfo": {
    "exec": "~/.config/polybar/scripts/sysinfo.sh",
    "interval": 2,
    "signal": 8,
    "tooltip-format": "Klik Kiri: Expand/Collapse Info RAM & Suhu | Klik Kanan: Buka btop",
    "on-click": "~/.config/polybar/scripts/sysinfo.sh --toggle",
    "on-click-right": "wezterm start -- btop"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} ",
    "tooltip-format": "Kecerahan Layar: {percent}% (Klik Kiri: Ubah, Klik Kanan: Slider Hub)",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "~/.config/polybar/scripts/hw-action.sh bright-cycle",
    "on-click-right": "~/.config/polybar/scripts/torray-hub.py --dash",
    "on-scroll-up": "~/.config/polybar/scripts/hw-action.sh bright-up",
    "on-scroll-down": "~/.config/polybar/scripts/hw-action.sh bright-down"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂰  {volume}%",
    "format-muted": "󰝟  Mute",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "~/.config/polybar/scripts/hw-action.sh vol-toggle",
    "on-click-right": "~/.config/polybar/scripts/torray-hub.py --dash",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5"
  },

  "custom/net_toggle": {
    "exec": "~/.config/polybar/scripts/net.sh",
    "interval": 2,
    "signal": 10,
    "tooltip-format": "Klik Kiri: Tampilkan Nama Wi-Fi & IP | Klik Kanan: Pilih Wi-Fi",
    "on-click": "~/.config/polybar/scripts/net.sh --toggle",
    "on-click-right": "~/.config/rofi/wifi.sh"
  },

  "custom/power_status": {
    "exec": "~/.config/polybar/scripts/power-status.sh",
    "interval": 2,
    "signal": 11,
    "tooltip-format": "Klik Kiri: Toggle Detail Power / Baterai",
    "on-click": "~/.config/polybar/scripts/power-status.sh --toggle",
    "on-click-right": "~/.config/polybar/scripts/torray-hub.py --dash"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 5
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power Menu (Super+Shift+E)",
    "on-click": "~/.config/rofi/powermenu.sh"
  }
}
